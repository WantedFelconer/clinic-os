NODE_ENV=development
PORT=5000

# Database Configuration (Option A: Discrete variables)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_os
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Database Configuration (Option B: Connection String for cloud providers like TiDB, Aiven, Railway, Supabase)
# DATABASE_URL=mysql://user:password@host:port/clinic_os?ssl={"rejectUnauthorized":true}

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=30m
JWT_ISSUER=clinic-os-api
JWT_AUDIENCE=clinic-os-web
SESSION_INACTIVITY_TIMEOUT_MS=1800000
ALLOW_EPHEMERAL_DEV_JWT=false

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# HTTPS / trusted reverse proxy (production enforces HTTPS by default)
ENFORCE_HTTPS=false
TRUST_PROXY=false
HTTPS_PORT=443
HTTPS_HEALTHCHECK_EXEMPT=false
HSTS_MAX_AGE_SECONDS=15552000
TLS_CERT_PATH=
TLS_KEY_PATH=

# Brevo Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ClinicOS
OTP_EXPIRATION_MINUTES=10

# Appointment reminder worker / protected external scheduler
APPOINTMENT_REMINDER_HOURS=24
APPOINTMENT_REMINDER_POLL_MS=900000
CRON_SECRET=<CONFIGURE_IN_ENVIRONMENT>

# Dedicated integration test database; name must contain "test" or "ci"
RUN_INTEGRATION_TESTS=false
TEST_DB_NAME=clinic_os_test

# Optional managed-MySQL certificate authority
DB_SSL_CA_PATH=
DB_SSL_CA_BASE64=
